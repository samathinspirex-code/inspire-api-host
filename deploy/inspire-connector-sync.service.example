[Unit]
Description=Inspire connector reports weekly sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/inspire-api-host
EnvironmentFile=/home/ubuntu/inspire-api-host/.env
ExecStart=/home/ubuntu/inspire-api-host/.venv/bin/python scripts/run_connector_sync.py
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
