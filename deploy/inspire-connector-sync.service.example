[Unit]
Description=Inspire connector reports weekly sync
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/inspire-api-host
# Settings come from .env in WorkingDirectory (read by the app). Do not add
# EnvironmentFile: systemd changes values containing special characters.
ExecStart=/home/ubuntu/inspire-api-host/.venv/bin/python scripts/run_connector_sync.py
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
