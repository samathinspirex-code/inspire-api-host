# Use the deployment secret manager for real values. Do not commit credentials.
CONNECTORS_GOOGLE_CLIENT_ID=
CONNECTORS_GOOGLE_CLIENT_SECRET=
# JSON object keyed by the saved CMS connector reference, NOT platform name.
# Replace 123 with the actual saved connector ID. Each token needs that account's scope.
CONNECTORS_CREDENTIALS={"123":{"refresh_token":"replace-in-secret-manager"}}
# Read-only scopes:
# GA4: https://www.googleapis.com/auth/analytics.readonly
# Search Console: https://www.googleapis.com/auth/webmasters.readonly
# YouTube: https://www.googleapis.com/auth/yt-analytics.readonly
