APP_NAME=Inspire API
ENVIRONMENT=development

POSTGRES_USER=inspire
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inspire_db

JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable. Changing it makes enrolled Authenticator secrets unreadable.
AUTHENTICATOR_ENCRYPTION_KEY=
AUTHENTICATOR_ISSUER=Inspire College
AUTHENTICATOR_SETUP_EXPIRE_MINUTES=30
AUTHENTICATOR_MAX_ATTEMPTS=5
AUTHENTICATOR_LOCK_MINUTES=5
AUTHENTICATOR_IP_RATE_LIMIT_PER_HOUR=30

# Authenticator setup invitations are sent through Mailjet. Create the API and
# secret keys in Mailjet, then validate the sender address or its entire domain.
# Configure SPF and DKIM on the sender domain before production use.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_FROM_EMAIL=lms@your-college-domain.com
MAILJET_FROM_NAME=Inspire College
AUTHENTICATOR_INVITATION_SUBJECT=Set up your Inspire College Authenticator

# Google Workspace OAuth credentials stay on the API server and must never be
# exposed through VITE_ variables or committed with real values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/lms/integrations/google/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value stable. Changing it makes stored lecturer refresh tokens unreadable.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_STATE_EXPIRE_MINUTES=10
LMS_UI_URL=http://localhost:5174
CMS_UI_URL=http://localhost:5173

# Optional. When configured, grounded course passages are rewritten into a
# natural answer through the OpenAI Responses API. Retrieval still works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
COURSE_ASSISTANT_MAX_PDF_MB=25
